function CreateServerSlot(server, index)
    local isCurrentServer = (server.id == game.JobId)

    local Slot = Create("Frame", ScrollContainer, {
        Size = UDim2.new(1, -6, 0, 87), 
        BackgroundTransparency = 1, 
        ZIndex = 5,
        LayoutOrder = index
    })

    local playing = server.playing or 0
    local maxPlayers = server.maxPlayers or 28
    local ping = server.ping or math.random(10, 35)
    local fps = ping > 0 and math.min(math.floor(1000 / ping), 60) or 60
    local serverId = server.id or "N/A"

    local pingColor
    if ping < 60 then
        pingColor = Color3.fromRGB(0, 255, 100)
    elseif ping < 120 then
        pingColor = Color3.fromRGB(255, 200, 50)
    else
        pingColor = Color3.fromRGB(255, 80, 80)
    end

    local pingTextHeader = string.format("PING : %dms", ping)
    if isCurrentServer then
        pingTextHeader = string.format("PING : %dms My server", ping)
    end

    local infoText = string.format(
        "%s\nFPS : %d\nPLAYERS : %d/%d\nGAME ID : %d\nID : %s",
        pingTextHeader, fps, playing, maxPlayers, game.PlaceId, serverId
    )

    local InfoLabel = Create("TextLabel", Slot, {
        Size = UDim2.new(0.65, 0, 1, 0), 
        Position = UDim2.new(0, 9, 0, 0), 
        BackgroundTransparency = 1,
        Font = Enum.Font.Arcade, 
        TextXAlignment = Enum.TextXAlignment.Left, 
        TextYAlignment = Enum.TextYAlignment.Center,
        Text = infoText,
        TextColor3 = Color3.fromRGB(255, 255, 255), 
        TextSize = 11, 
        ZIndex = 6
    })

    local lines = {}
    for line in infoText:gmatch("[^\n]+") do
        table.insert(lines, line)
    end
    if #lines >= 1 then
        if isCurrentServer then
            lines[1] = string.format('<font color="rgb(%d,%d,%d)">PING : %dms</font> <font color="rgb(0,255,100)">My server</font>', 
                pingColor.R * 255, pingColor.G * 255, pingColor.B * 255, ping)
        else
            lines[1] = string.format('<font color="rgb(%d,%d,%d)">PING : %dms</font>', 
                pingColor.R * 255, pingColor.G * 255, pingColor.B * 255, ping)
        end
        InfoLabel.Text = table.concat(lines, "\n")
        InfoLabel.RichText = true
    end

    local JoinButton = Create("TextButton", Slot, {
        Name = "JoinButton", 
        Size = UDim2.new(0, 85, 0, 25), 
        Position = UDim2.new(1, -95, 0, 11),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), 
        Font = Enum.Font.Arcade, 
        Text = "JOIN",
        TextColor3 = Color3.fromRGB(255, 255, 255), 
        TextSize = 12, 
        ZIndex = 6
    }, nil, { Color = Color3.fromRGB(255, 255, 255), Thickness = 1 })

    JoinButton.MouseButton1Click:Connect(function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, lp)
        end)
    end)

    local CopyButton = Create("TextButton", Slot, {
        Name = "CopyButton", 
        Size = UDim2.new(0, 85, 0, 25), 
        Position = UDim2.new(1, -95, 0, 46),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0), 
        Font = Enum.Font.Arcade, 
        Text = "COPY",
        TextColor3 = Color3.fromRGB(255, 255, 255), 
        TextSize = 11, 
        ZIndex = 6
    }, nil, { Color = Color3.fromRGB(255, 255, 255), Thickness = 1 })

    CopyButton.MouseButton1Click:Connect(function()
        if Clipboard and serverId and serverId ~= "N/A" then
            Clipboard(serverId)
        end
    end)

    Create("Frame", Slot, {
        Size = UDim2.new(1, -16, 0, 1), 
        Position = UDim2.new(0, 8, 1, -1),
        BackgroundColor3 = Color3.fromRGB(40, 40, 40), 
        BorderSizePixel = 0, 
        ZIndex = 6
    })

    table.insert(serverFrames, Slot)
    return Slot
end

function GetAllServers(placeId)
    local servers = {}
    local currentServerFound = false

    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))

        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id == game.JobId then
                    currentServerFound = true
                end
                table.insert(servers, server)
            end
        end

        local cursor = data.nextPageCursor
        while cursor and #servers < 100 do
            local nextUrl = url .. "&cursor=" .. cursor
            local nextData = HttpService:JSONDecode(game:HttpGet(nextUrl))
            if nextData and nextData.data then
                for _, server in ipairs(nextData.data) do
                    if server.id == game.JobId then
                        currentServerFound = true
                    end
                    table.insert(servers, server)
                end
            end
            cursor = nextData.nextPageCursor
        end
    end)

    if not currentServerFound then
        table.insert(servers, 1, {
            id = game.JobId,
            playing = #Players:GetPlayers(),
            maxPlayers = 28,
            ping = 13
        })
    end

    return servers
end

function UpdateServerList(servers)
    for _, frame in ipairs(serverFrames) do
        frame:Destroy()
    end
    serverFrames = {}

    if #servers == 0 then
        ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
        return
    end

    table.sort(servers, function(a, b)
        if a.id == game.JobId then return true end
        if b.id == game.JobId then return false end
        return (a.ping or 999) < (b.ping or 999)
    end)

    if #servers > 50 then
        for i = #servers, 51, -1 do
            if servers[i].id ~= game.JobId then
                table.remove(servers, i)
            end
        end
    end

    for i, server in ipairs(servers) do
        CreateServerSlot(server, i)
    end

    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, #serverFrames * 92)
end

function RefreshServers()
    if isRefreshing then return end
    isRefreshing = true

    task.spawn(function()
        UpdateServerList(GetAllServers(game.PlaceId))
        isRefreshing = false
    end)
end

local function makeDraggable(obj)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local isDragging = false

    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isDragging = false
            dragStart = input.Position
            startPos = obj.Position
        end
    end)

    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            isDragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
                         input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if not isDragging then
                isDragging = true
            end
            obj.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

